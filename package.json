{
  "name": "owen-exporter",
  "version": "0.1.0",
  "description": "Obsidian plugin for exporting SVG embeds and Markdown selections.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "export",
    "svg",
    "html"
  ],
  "author": "Owen Lee",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.14.10",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.23.0",
    "obsidian": "^1.6.7",
    "tslib": "^2.6.3",
    "typescript": "^5.5.3"
  }
}
